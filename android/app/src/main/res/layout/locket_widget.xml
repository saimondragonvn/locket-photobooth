<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:padding="0dp">

    <!-- Live Moment Photo Layer (Hidden when empty, shown when a friend photo arrives) -->
    <ImageView
        android:id="@+id/widget_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@string/widget_name" />

    <!-- Default "Your Friends" Card (Matches Locket Widget Sheet screenshot) -->
    <LinearLayout
        android:id="@+id/widget_empty_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/widget_heart_ring">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_heart_white"
                android:contentDescription="@string/widget_name" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Your Friends"
            android:textColor="#FFF3F4F6"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Top-Right Refresh Button -->
    <ImageButton
        android:id="@+id/widget_refresh_btn"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/widget_badge_bg"
        android:padding="5dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_refresh_white"
        android:contentDescription="Refresh" />

    <!-- Bottom Caption Pill (when moment has caption) -->
    <TextView
        android:id="@+id/widget_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/widget_badge_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="#FFFFFFFF"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone" />

    <!-- Bottom-Left Author Avatar + Name Pill -->
    <LinearLayout
        android:id="@+id/widget_author_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="9dp"
        android:background="@drawable/widget_badge_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingEnd="9dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_author_avatar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="5dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="Avatar" />

        <TextView
            android:id="@+id/widget_author_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="110dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>

