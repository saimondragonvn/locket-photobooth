{
  "meta": {
    "format": "https://www.designtokens.org/TR/drafts/format/",
    "product": "Locket Photobooth",
    "surface": "dashboard-web-app",
    "url": "https://locket-file.vercel.app/dashboard",
    "wcagTarget": "2.2-AA",
    "componentDensityBaseline": {
      "buttons": 14,
      "inputs": 1,
      "navigation": 1
    }
  },
  "primitive": {
    "font": {
      "family": {
        "primary": { "$value": "Inter", "$type": "fontFamily", "$description": "Extracted primary typeface" },
        "stack": { "$value": "Inter, sans-serif", "$type": "fontFamily", "$description": "Extracted font stack" }
      },
      "size": {
        "xs": { "$value": "15px", "$type": "dimension", "$description": "Extracted compact metadata/secondary label size" },
        "sm": { "$value": "16px", "$type": "dimension", "$description": "Extracted control and body size" },
        "base": { "$value": "16px", "$type": "dimension", "$description": "Extracted base document font size" },
        "md": { "$value": "20px", "$type": "dimension", "$description": "[Calibrated] Panel and section heading size" },
        "lg": { "$value": "24px", "$type": "dimension", "$description": "[Calibrated] Page heading size" }
      },
      "weight": {
        "base": { "$value": 400, "$type": "fontWeight", "$description": "Extracted base font weight" },
        "medium": { "$value": 500, "$type": "fontWeight", "$description": "[Calibrated] Interactive control weight" },
        "semibold": { "$value": 600, "$type": "fontWeight", "$description": "[Calibrated] Structural heading weight" }
      },
      "lineHeight": {
        "xs": { "$value": "20px", "$type": "dimension", "$description": "[Calibrated] Line height paired with font.size.xs" },
        "base": { "$value": "24px", "$type": "dimension", "$description": "Extracted base line height" },
        "md": { "$value": "28px", "$type": "dimension", "$description": "[Calibrated] Line height paired with font.size.md" },
        "lg": { "$value": "32px", "$type": "dimension", "$description": "[Calibrated] Line height paired with font.size.lg" }
      }
    },
    "color": {
      "surface": {
        "base": { "$value": "#000000", "$type": "color", "$description": "Extracted root canvas surface" }
      },
      "text": {
        "primary": { "$value": "#fffdf7", "$type": "color", "$description": "Extracted warm primary text (20.71:1 on #000000)" },
        "secondary": { "$value": "#ffffff", "$type": "color", "$description": "Extracted crisp emphasis text (21.00:1 on #000000)" }
      },
      "neutral": {
        "200": { "$value": "#e6e4de", "$type": "color", "$description": "[Calibrated] Pressed fill for inverted primary controls (16.4:1 vs #000000)" },
        "400": { "$value": "#949494", "$type": "color", "$description": "[Calibrated] Muted foreground (6.97:1 on #000000, 5.92:1 on #141414)" },
        "500": { "$value": "#767676", "$type": "color", "$description": "[Calibrated] Non-text control border (4.54:1 on #000000, 3.86:1 on #141414)" },
        "600": { "$value": "#525252", "$type": "color", "$description": "[Calibrated] Disabled text and border token" },
        "700": { "$value": "#2b2b2b", "$type": "color", "$description": "[Calibrated] Active/pressed dark surface" },
        "800": { "$value": "#1f1f1f", "$type": "color", "$description": "[Calibrated] Hover dark surface" },
        "900": { "$value": "#141414", "$type": "color", "$description": "[Calibrated] Elevated container and input surface" }
      },
      "red": {
        "400": { "$value": "#ff6b6b", "$type": "color", "$description": "[Calibrated] Error foreground and border (7.43:1 on #000000, 6.31:1 on #141414)" },
        "950": { "$value": "#2d0a0a", "$type": "color", "$description": "[Calibrated] Subtle error container surface" }
      }
    },
    "space": {
      "1": { "$value": "2px", "$type": "dimension", "$description": "Extracted micro offset / focus ring width" },
      "2": { "$value": "6px", "$type": "dimension", "$description": "Extracted tight inline icon-label gap" },
      "3": { "$value": "12px", "$type": "dimension", "$description": "Extracted compact control padding / cluster gap" },
      "4": { "$value": "14px", "$type": "dimension", "$description": "Extracted standard input/button block padding" },
      "5": { "$value": "16px", "$type": "dimension", "$description": "Extracted standard inline padding / section gap" },
      "6": { "$value": "22px", "$type": "dimension", "$description": "Extracted spacious control inline padding" },
      "7": { "$value": "24px", "$type": "dimension", "$description": "Extracted layout container padding and macro gap" }
    },
    "radius": {
      "xs": { "$value": "14px", "$type": "dimension", "$description": "Extracted compact utility button and input radius" },
      "sm": { "$value": "16px", "$type": "dimension", "$description": "Extracted card, nav container, and secondary control radius" },
      "md": { "$value": "50px", "$type": "dimension", "$description": "Extracted pill CTA and active nav indicator radius" }
    },
    "shadow": {
      "1": {
        "$value": "rgba(0, 0, 0, 0.15) 0px 0px 0px 1px, rgba(0, 0, 0, 0.15) 0px 0px 0px 1px inset",
        "$type": "shadow",
        "$description": "Extracted subtle structural hairline ring"
      }
    },
    "motion": {
      "duration": {
        "instant": { "$value": "150ms", "$type": "duration", "$description": "Extracted hover/active micro-state transition" },
        "fast": { "$value": "180ms", "$type": "duration", "$description": "Extracted focus/validation feedback transition" },
        "normal": { "$value": "200ms", "$type": "duration", "$description": "Extracted navigation/drawer state transition" },
        "slow": { "$value": "350ms", "$type": "duration", "$description": "Extracted modal/layout transition ceiling" }
      },
      "easing": {
        "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)", "$type": "cubicBezier", "$description": "[Calibrated] Deterministic UI easing curve" }
      }
    },
    "size": {
      "control": {
        "compactMin": { "$value": "36px", "$type": "dimension", "$description": "[Calibrated] Pointer control floor (>= 24px WCAG 2.5.8 AA)" },
        "touchMin": { "$value": "44px", "$type": "dimension", "$description": "[Calibrated] Touch target floor for booth/tablet operators" }
      }
    }
  },
  "semantic": {
    "surface": {
      "canvas": { "$value": "{primitive.color.surface.base}", "$type": "color" },
      "elevated": { "$value": "{primitive.color.neutral.900}", "$type": "color" },
      "hover": { "$value": "{primitive.color.neutral.800}", "$type": "color" },
      "active": { "$value": "{primitive.color.neutral.700}", "$type": "color" },
      "errorSubtle": { "$value": "{primitive.color.red.950}", "$type": "color" }
    },
    "text": {
      "primary": { "$value": "{primitive.color.text.primary}", "$type": "color" },
      "emphasis": { "$value": "{primitive.color.text.secondary}", "$type": "color" },
      "muted": { "$value": "{primitive.color.neutral.400}", "$type": "color" },
      "inverse": { "$value": "{primitive.color.surface.base}", "$type": "color" },
      "disabled": { "$value": "{primitive.color.neutral.600}", "$type": "color" },
      "error": { "$value": "{primitive.color.red.400}", "$type": "color" }
    },
    "border": {
      "default": { "$value": "{primitive.color.neutral.500}", "$type": "color" },
      "emphasis": { "$value": "{primitive.color.text.secondary}", "$type": "color" },
      "disabled": { "$value": "{primitive.color.neutral.600}", "$type": "color" },
      "error": { "$value": "{primitive.color.red.400}", "$type": "color" }
    },
    "focus": {
      "ringColor": { "$value": "{primitive.color.text.secondary}", "$type": "color" },
      "offsetColor": { "$value": "{primitive.color.surface.base}", "$type": "color" },
      "ringWidth": { "$value": "{primitive.space.1}", "$type": "dimension" },
      "ringOffset": { "$value": "{primitive.space.1}", "$type": "dimension" }
    },
    "action": {
      "primary": {
        "bgDefault": { "$value": "{primitive.color.text.primary}", "$type": "color" },
        "bgHover": { "$value": "{primitive.color.text.secondary}", "$type": "color" },
        "bgActive": { "$value": "{primitive.color.neutral.200}", "$type": "color" },
        "fgDefault": { "$value": "{primitive.color.surface.base}", "$type": "color" }
      },
      "secondary": {
        "bgDefault": { "$value": "{primitive.color.neutral.900}", "$type": "color" },
        "bgHover": { "$value": "{primitive.color.neutral.800}", "$type": "color" },
        "bgActive": { "$value": "{primitive.color.neutral.700}", "$type": "color" },
        "fgDefault": { "$value": "{primitive.color.text.primary}", "$type": "color" }
      },
      "ghost": {
        "bgHover": { "$value": "{primitive.color.neutral.800}", "$type": "color" },
        "bgActive": { "$value": "{primitive.color.neutral.700}", "$type": "color" },
        "fgDefault": { "$value": "{primitive.color.text.primary}", "$type": "color" }
      },
      "destructive": {
        "bgDefault": { "$value": "{primitive.color.red.950}", "$type": "color" },
        "bgHover": { "$value": "{primitive.color.neutral.800}", "$type": "color" },
        "bgActive": { "$value": "{primitive.color.neutral.700}", "$type": "color" },
        "fgDefault": { "$value": "{primitive.color.red.400}", "$type": "color" }
      }
    }
  },
  "component": {
    "button": {
      "paddingInlinePrimary": { "$value": "{primitive.space.6}", "$type": "dimension" },
      "paddingInlineCompact": { "$value": "{primitive.space.5}", "$type": "dimension" },
      "paddingBlock": { "$value": "{primitive.space.3}", "$type": "dimension" },
      "gap": { "$value": "{primitive.space.2}", "$type": "dimension" },
      "radiusPrimary": { "$value": "{primitive.radius.md}", "$type": "dimension" },
      "radiusSecondary": { "$value": "{primitive.radius.sm}", "$type": "dimension" },
      "radiusUtility": { "$value": "{primitive.radius.xs}", "$type": "dimension" }
    },
    "input": {
      "paddingInline": { "$value": "{primitive.space.5}", "$type": "dimension" },
      "paddingBlock": { "$value": "{primitive.space.4}", "$type": "dimension" },
      "gap": { "$value": "{primitive.space.2}", "$type": "dimension" },
      "radius": { "$value": "{primitive.radius.xs}", "$type": "dimension" }
    },
    "navigation": {
      "containerPadding": { "$value": "{primitive.space.3}", "$type": "dimension" },
      "itemPaddingInline": { "$value": "{primitive.space.5}", "$type": "dimension" },
      "itemPaddingBlock": { "$value": "{primitive.space.3}", "$type": "dimension" },
      "itemGap": { "$value": "{primitive.space.2}", "$type": "dimension" },
      "containerRadius": { "$value": "{primitive.radius.sm}", "$type": "dimension" },
      "activePillRadius": { "$value": "{primitive.radius.md}", "$type": "dimension" }
    }
  }
}

